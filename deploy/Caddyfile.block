# Einzufügen in ~/nz-dienstplan/Caddyfile auf dem Server.
#
# Dieser Block gehört NICHT in eine eigene Datei auf dem Server — der Caddy
# des Dienstwerk-Stacks liest genau eine Konfiguration, und die liegt im
# Git-Verzeichnis ~/nz-dienstplan. Der Block wird dort ans Ende angehängt,
# committet und der Proxy neu geladen:
#
#     cd ~/nz-dienstplan && git pull
#     docker exec nz-dienstplan-caddy-1 caddy reload --config /etc/caddy/Caddyfile
#
# Vor dem Einfügen den Passwort-Hash erzeugen und unten eintragen:
#
#     docker run --rm caddy:2.10-alpine caddy hash-password
#
# Anders als in der .env-Datei wird hier NICHT verdoppelt: das Caddyfile
# liest den Hash unverändert. Nur in Compose-Dateien müssen Dollarzeichen
# doppelt geschrieben werden.

ano.neuro-vibe.de {
	encode zstd gzip

	# ------------------------------------------------------------- Zugang
	# Ohne Zugangsschutz könnte jeder, der die Adresse kennt, Arztbriefe
	# hochladen. Die Anwendung hat keine eigene Benutzerverwaltung.
	#
	# /health bleibt ausgenommen, damit Caddy und Docker die Bereitschaft
	# prüfen können, ohne Zugangsdaten mitzuführen. Der Endpunkt gibt nur
	# Status und Modellnamen zurück, keine Dokumentdaten.
	@geschuetzt not path /health
	basic_auth @geschuetzt {
		anonymisator HIER_DEN_BCRYPT_HASH_EINTRAGEN
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

		# Die Oberfläche kommt ohne fremde Quellen aus. 'unsafe-inline' für
		# style-src, weil die Kategoriefarben je Element gesetzt werden.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"

		-Server
	}

	# Muss über ANON_MAX_UPLOAD_MB der Anwendung liegen (dort 30 MB), sonst
	# bricht der Proxy ab, bevor die Anwendung eine verständliche Meldung
	# geben kann.
	request_body {
		max_size 50MB
	}

	# Der Containername stammt aus docker-compose.server.yml. Beide müssen
	# im Netz nz-dienstplan_app liegen, sonst findet Caddy den Dienst nicht.
	reverse_proxy anonymisator:8000 {
		health_uri /health
		health_interval 30s
		health_timeout 5s
	}
}

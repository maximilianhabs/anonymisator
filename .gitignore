.venv/
__pycache__/
*.pyc
.DS_Store
.claude/

# --------------------------------------------------------------------------
# Echte Dokumente dürfen dieses Repository niemals erreichen.
# Dieses Projekt verarbeitet Arztbriefe und Gutachten; ein versehentlich
# eingechecktes Testdokument wäre ein Datenschutzvorfall und bliebe für immer
# in der Commit-Historie stehen.
# --------------------------------------------------------------------------
*.pdf
*.docx
*.doc
*.odt
*.rtf
*.txt
!requirements.txt
!requirements-core.txt
!requirements-model.txt
# Goldkorpus-Briefe sind frei erfunden und gehören bewusst ins Repo (siehe
# CONTRIBUTING.md) -- kein echtes Dokument, deshalb eine gezielte Ausnahme
# statt die generelle Sperre aufzuweichen.
!tests/goldkorpus/*.txt

# Zuordnungstabellen enthalten Klarnamen im Klartext.
*ZUORDNUNG*
*_anonymisiert.*

# Arbeitsordner für eigene Testdateien
testdaten/
scratch/
.env

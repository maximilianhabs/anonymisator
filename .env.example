# Vorlage für .env — kopieren und anpassen:
#
#     cp .env.example .env
#
# Die Datei .env selbst gehört nicht ins Repository und ist in .gitignore
# gesperrt.

# ==========================================================================
# Zugang — bitte zuerst lesen
# ==========================================================================
# Ohne Zugangsschutz kann jeder, der die Adresse kennt, Arztbriefe hochladen.
# Der Dienst hat keine eigene Benutzerverwaltung; die Zugangskontrolle liegt
# beim Reverse Proxy.
#
# Hash erzeugen (das Passwort erscheint dabei nicht im Klartext in .env):
#
#     docker run --rm caddy:2.10-alpine caddy hash-password
#
# Das Dollarzeichen im Hash muss für Compose verdoppelt werden: aus $2a$14$...
# wird $$2a$$14$$...
ANON_BASIC_AUTH_USER=anonymisator
ANON_BASIC_AUTH_HASH=

# ==========================================================================
# Netz
# ==========================================================================
# Erreichbare Domain für automatisches HTTPS über Let's Encrypt.
# Für Betrieb ohne Domain — etwa im Klinik- oder Praxisnetz — hier ":80"
# eintragen; dann bleibt es bei unverschlüsseltem HTTP im lokalen Netz.
ANON_DOMAIN=:80

# Adresse für Ablaufwarnungen von Let's Encrypt. Bei ":80" ohne Bedeutung.
ANON_TLS_MAIL=

# Veröffentlichte Ports des Reverse Proxy auf dem Wirtssystem.
ANON_HTTP_PORT=80
ANON_HTTPS_PORT=443

# ==========================================================================
# Anwendung
# ==========================================================================
# Arbeitsprozesse. Als Anhaltspunkt ein Prozess je Kern, mindestens zwei.
# Jeder Prozess hält eine eigene Kopie des Sprachmodells im Speicher —
# rund 600 MB. Der Speicherbedarf wächst also linear mit dieser Zahl.
ANON_WORKERS=2

# Obergrenze für Uploads in MB. Muss unter ANON_PROXY_MAX_BODY liegen.
ANON_MAX_UPLOAD_MB=60

# Grösste Seitenzahl, die per OCR gelesen wird. Ein Scan mit 200 Seiten
# blockiert einen Arbeitsprozess sonst über viele Minuten.
ANON_MAX_OCR_SEITEN=50

# Grösste Seitenzahl insgesamt, auch bei vorhandenem Textlayer. Gemessen:
# 500 Seiten belegen rund 2,8 GB Arbeitsspeicher und brauchen etwa 70
# Sekunden. Ohne Grenze würde der Behälter bei sehr grossen Dokumenten
# abgeräumt, statt eine verständliche Meldung zu geben.
ANON_MAX_SEITEN=300

# Auflösung beim Rastern gescannter Seiten. Darunter leidet die Lesequalität
# bei kleinen Serifenschriften spürbar, darüber wird es nur langsamer.
ANON_OCR_DPI=300

# Tesseract-Sprachpaket. Nur die im Abbild enthaltenen sind verfügbar;
# beigelegt ist Deutsch. Mehrere mit "+" verketten, etwa "deu+eng" — dafür
# muss das jeweilige Paket im Dockerfile ergänzt werden.
ANON_OCR_SPRACHE=deu

# Speichergrenze des Anwendungsbehälters.
#
# Gemessen auf einem Dokument mit Textlayer: 100 Seiten rund 1,0 GB,
# 250 Seiten 1,9 GB, 500 Seiten 2,8 GB. Dazu kommt das Sprachmodell mit
# etwa 600 MB **je Arbeitsprozess**.
#
# Faustwert: 600 MB × ANON_WORKERS + 2 GB Verarbeitungsspielraum. Bei zwei
# Prozessen und ANON_MAX_SEITEN=300 sind 4 GB ein tragfähiger Wert; wer die
# Seitengrenze anhebt, muss hier mitziehen.
ANON_MEM_LIMIT=4g

# Obergrenze des Reverse Proxy. Muss über ANON_MAX_UPLOAD_MB liegen, sonst
# bricht der Proxy ab, bevor die Anwendung eine verständliche Meldung geben
# kann.
ANON_PROXY_MAX_BODY=80MB

# ==========================================================================
# Protokollierung
# ==========================================================================
# DEBUG, INFO, WARNING, ERROR. Auf keiner Stufe werden Dokumentinhalte,
# Dateinamen oder erkannte Entitäten protokolliert.
ANON_LOG_LEVEL=INFO

# JSON-Zeilen für Log-Sammler wie Loki oder journald. "false" liefert
# lesbaren Klartext.
ANON_LOG_JSON=true

# ==========================================================================
# Abbild
# ==========================================================================
# Etikett des gebauten Abbilds.
ANON_VERSION=latest

# Zugangsschutz abschalten (nur für abgeschottete Netze!)
ANON_AUTH_AKTIV=true
